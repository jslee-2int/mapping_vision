   <string notr="true">QMainWindow {
    background-color: #000000;
    color: #ffffff;
}

QWidget {
    background-color: #000000;
    color: #ffffff;
}

QGroupBox {
    border: 1px solid #3f3f3f;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 8px;
    color: #ffffff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 3px;
}

QPushButton {
    background-color: #2d2d2d;
    border: 1px solid #3f3f3f;
    border-radius: 4px;
    color: #ffffff;
    padding: 5px 15px;
}

QPushButton:hover {
    background-color: #3f3f3f;
}

QPushButton:pressed {
    background-color: #505050;
}

QLineEdit {
    background-color: #2d2d2d;
    border: 1px solid #3f3f3f;
    border-radius: 4px;
    color: #ffffff;
    padding: 3px;
}

QComboBox {
    background-color: #2d2d2d;
    border: 1px solid #3f3f3f;
    border-radius: 4px;
    color: #ffffff;
    padding: 3px;
}

QComboBox::drop-down {
    border: none;
}

QSpinBox, QDoubleSpinBox {
    background-color: #2d2d2d;
    border: 1px solid #3f3f3f;
    border-radius: 4px;
    color: #ffffff;
    padding: 3px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    width: 0px;
    border: none;
}

QFrame {
    border: 1px solid #3f3f3f;
    background-color: #2d2d2d;
}

QProgressBar {
    border: 1px solid #3f3f3f;
    border-radius: 4px;
    background-color: #2d2d2d;
    color: #ffffff;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #505050;
}

MatplotlibWidget, ToolbarWidget {
    background-color: #2d2d2d;
    border: 1px solid #3f3f3f;
}

QLabel {
    color: #ffffff;
    background: transparent;
    border: none;
}

QToolBox {
    background-color: #000000;
    border: 0px solid #3f3f3f;
    border-radius: 4px;
}

QToolBox::tab {
    background-color: #2d2d2d;
    border: 1px solid #3f3f3f;
    border-radius: 4px;
    padding: 0px;
    margin: 0px;
	color: white;
}

QToolBox::tab:selected {
    background-color: #3f3f3f;
    border: 1px solid #505050;
}

QToolBox::tab:hover {
    background-color: #3f3f3f;
}

QToolBox::tab:!selected {
    background-color: #2d2d2d;
}

QToolBox::tab:!selected:hover {
    background-color: #3f3f3f;
}

QToolBox::tab:!selected:disabled {
    background-color: #1a1a1a;
    color: #606060;
}

QToolBox::tab:selected:disabled {
    background-color: #1a1a1a;
    color: #606060;
}</string>
